# VirusTotal API Key (free tier: 4 req/min, 500 req/day)
# Get one at: https://www.virustotal.com/gui/join-us
VT_API_KEY=your_virustotal_api_key_here

# urlscan.io API Key (free tier)
# Get one at: https://urlscan.io/user/signup
URLSCAN_API_KEY=your_urlscan_api_key_here

# Google Safe Browsing API Key (v4)
# Get one at: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here

# abuse.ch URLhaus API Key (optional - basic lookups work without a key)
# Get one at: https://urlhaus.abuse.ch/api/
URLHAUS_API_KEY=your_urlhaus_api_key_here

