# Copy this file to .env (same folder) and fill in your keys.
# .env is loaded automatically — no need to `export`/`set` anything in your
# shell, and it works the same across every terminal, OS, or WSL session.
#
# Both are free-tier API keys:
#   VT_API_KEY       -> https://www.virustotal.com/gui/join-us
#   URLSCAN_API_KEY  -> https://urlscan.io/user/signup

VT_API_KEY=
URLSCAN_API_KEY=
